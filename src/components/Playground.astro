---
/**
 * Playground index: a grid of the interface experiments.
 * The demos themselves are static pages in public/playground/<slug>/, untouched.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import { demos } from '../data/playground';
import { site } from '../data/site';
import { homePath, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const thumbs = import.meta.glob<{ default: ImageMetadata }>('../assets/playground/*.jpg', { eager: true });
const thumbOf = (slug: string) => thumbs[`../assets/playground/${slug}.jpg`]?.default;
---

<Base lang={lang} title={`Playground — ${site.name}`} description={t.pgLead}>
  <Header lang={lang} />
  <main class="wrap page">
    <p class="kicker">Playground · {demos.length} {t.pgCount}</p>
    <h1 class="title">Playground</h1>
    <p class="lead">{t.pgLead}</p>

    <ul class="grid">
      {
        demos.map((d) => {
          const img = thumbOf(d.slug);
          return (
            <li class="card">
              <a class="thumb" href={`/playground/${d.slug}/`} aria-label={`${t.pgOpen}: ${d.title}`}>
                {img && <Image src={img} alt="" widths={[360, 720]} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 380px" loading="lazy" />}
              </a>
              <div class="meta">
                <h2 class="name">
                  <a href={`/playground/${d.slug}/`}>{d.title}</a>
                </h2>
                <ul class="tech" aria-label="Stack">
                  {d.tech.map((x) => <li>{x}</li>)}
                </ul>
                <p class="actions">
                  <a class="link" href={`/playground/${d.slug}/`}>{t.pgOpen} →</a>
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>

    <p class="back"><a class="link" href={homePath[lang]}>← {t.pgBack}</a></p>
  </main>
  <footer class="wrap footer">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span>{t.madeIn} {site.location.city}</span>
  </footer>
</Base>

<style>
  .page {
    padding-top: 64px;
  }
  .kicker {
    font: 500 13px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .kicker::before {
    content: '●';
    color: var(--hot);
    margin-right: 10px;
  }
  .title {
    margin: 28px 0 0 -0.04em;
    font: 900 clamp(72px, 16vw, 220px) / 0.82 var(--sans);
    font-stretch: 62%;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .lead {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 2px solid var(--ink);
    max-width: 52ch;
    font: 500 clamp(20px, 2vw, 26px) / 1.35 var(--sans);
    font-stretch: 88%;
    letter-spacing: -0.01em;
  }

  /* ---- Grid of demos ---- */
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 28px;
    margin-top: 56px;
  }
  .card {
    display: flex;
    flex-direction: column;
  }
  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--line);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card:hover .thumb :global(img) {
    transform: scale(1.04);
  }
  /* Stack labels, under the title */
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
    list-style: none;
  }
  .tech li {
    padding: 3px 8px 2px;
    border: 1px solid color-mix(in srgb, var(--muted) 55%, transparent);
    color: var(--ink);
    font: 500 11px / 1.4 var(--mono);
    letter-spacing: 0.02em;
  }
  .meta {
    padding-top: 14px;
    border-top: 2px solid var(--ink);
    margin-top: 14px;
  }
  .name {
    font: 900 clamp(24px, 2.4vw, 32px) / 1 var(--sans);
    font-stretch: 62%;
    text-transform: uppercase;
  }
  .name a {
    text-decoration: none;
  }
  .name a:hover {
    color: var(--accent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 10px;
  }
  .actions .link {
    font-size: 13px;
  }
  .back {
    margin-top: 72px;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 96px;
    padding-block: 20px 32px;
    border-top: 1px solid var(--line);
    font: 400 13px var(--mono);
    color: var(--muted);
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .page {
      padding-top: 40px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
