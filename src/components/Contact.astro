---
import { site } from '../data/site';
import { ui, playgroundPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="contact" class="wrap section contact">
  <h2 class="say">{t.sayBefore}<span class:list={['it', { wide: t.sayWide }]}>{t.sayAccent}</span>{t.sayAfter}</h2>
  <div class="row">
    <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
    <p class="links">
      <a class="link" href={site.links.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a>
      <a class="link" href={site.links.github} rel="me noopener" target="_blank">GitHub ↗</a>
      <a class="link" href={playgroundPath[lang]}>Playground →</a>
    </p>
  </div>
</section>

<footer class="wrap footer">
  <span>© {new Date().getFullYear()} {site.name}</span>
  <span>{t.madeIn} {site.location.city}</span>
</footer>

<style>
  .say {
    font: 900 clamp(76px, 17vw, 240px) / 0.8 var(--sans);
    font-stretch: 62%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .it {
    color: var(--hot);
  }
  .it.wide {
    font-stretch: 125%;
    font-weight: 800;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px 40px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }
  .mail {
    font: 800 clamp(26px, 4vw, 52px) / 1.1 var(--sans);
    font-stretch: 80%;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .mail:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 120px;
    padding-block: 20px 32px;
    border-top: 1px solid var(--line);
    font: 400 13px var(--mono);
    color: var(--muted);
  }
</style>
